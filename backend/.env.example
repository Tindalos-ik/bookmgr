# Local Docker MySQL. Replace both passwords before first startup.
MYSQL_ROOT_PASSWORD=change-this-root-password
MYSQL_DATABASE=bookmgr
MYSQL_USER=bookmgr
MYSQL_PASSWORD=change-this-app-password
MYSQL_PORT=3307

# Keep credentials and port consistent with the values above.
DATABASE_URL=mysql+aiomysql://bookmgr:change-this-app-password@127.0.0.1:3307/bookmgr?charset=utf8mb4
